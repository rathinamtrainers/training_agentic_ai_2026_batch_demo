# Copy this file to .env and fill in the two values that are blank.
#
#     cp .env.example .env
#
# .env is gitignored. No key, token or password is ever committed here.

# --- The model ---------------------------------------------------------------
# A Gemini API key from https://aistudio.google.com/apikey
# This is the only value the agent demos genuinely need.
GOOGLE_API_KEY=

# The model name lives here and in README.md, never on a slide, because names
# rot faster than a sixteen-week course runs. gemini-2.5-flash, which this
# course was first written against, was retired for new keys in August 2026.
# An exact version on purpose, not the gemini-flash-latest alias: the alias
# drifts and would quietly invalidate the price list in usage.py.
GEMINI_MODEL=gemini-3.7-flash

# Session 2 uses the API-key path. Vertex AI with Application Default
# Credentials is session 4's business, because that is where we deploy.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# --- The fallback, if the model API is down on the night ---------------------
# Set MODEL_BACKEND=ollama, have `ollama serve` running, and install the extra:
#     uv sync --extra ollama
# Not taught tonight. Session 3 teaches local models properly.
MODEL_BACKEND=gemini
OLLAMA_MODEL=llama3.1
OLLAMA_API_BASE=http://localhost:11434

# --- Postgres (declared tonight, used from session 3) ------------------------
# docker compose reads these. POSTGRES_PASSWORD has no default on purpose:
# compose refuses to start without one, rather than shipping a password in a
# file. Any value will do; this database is local and disposable.
POSTGRES_PASSWORD=
POSTGRES_DB=agentic
POSTGRES_USER=agentic
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
