# Copy this file to .env and fill in the blanks.
#
#     cp .env.example .env
#
# .env is gitignored. No key, token or password is ever committed in this
# repository, and every variable below is read in exactly one place: config.py.

# --- Which credentials -------------------------------------------------------
# api_key : a free Gemini API key. Everything except deployment and the RAGAS
#           score runs on this. It is the laptop path and the default.
# vertex  : Application Default Credentials against a Google Cloud project.
#           Required by deployment/ and by eval/run_ragas.py.
GENAI_BACKEND=api_key

# --- The model, on the api_key path -----------------------------------------
# A free key from https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# --- The model, on the vertex path ------------------------------------------
# Needed only when GENAI_BACKEND=vertex. Run `gcloud auth application-default
# login` as well; there is no key for this path and there should not be.
GOOGLE_CLOUD_PROJECT=
# VERIFIED 2026-08-28, and it bites: on the Vertex path the gemini-3.x models
# are served from the `global` endpoint only. With us-central1 below,
# gemini-3.7-flash returns 404 NOT_FOUND and gemini-2.5-flash is all you get.
# Agent Runtime (deployment/) needs a REGION and does not accept `global`, so
# these two uses of one variable pull in opposite directions: run steps 0-5
# with GOOGLE_CLOUD_LOCATION=global, and set it to us-central1 for the deploy.
GOOGLE_CLOUD_LOCATION=us-central1

# --- Model ids ---------------------------------------------------------------
# Pinned here and in README.md, never on a slide. gemini-3.7-flash went GA on
# 2026-08-13. If your key does not carry it, gemini-2.5-flash still resolves.
GEMINI_MODEL=gemini-3.7-flash
GEMINI_PRO_MODEL=gemini-3.1-pro
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# --- Retrieval ---------------------------------------------------------------
# The reranker costs one extra model call per question. Turn it off to run the
# 'before' half of the RAGAS comparison.
RERANK=on
TOP_K=5
RERANK_CANDIDATES=12
# Passages the reranker scores below this are dropped, which is how the agent
# gets to say "That is not in the documents." -- retrieval on its own always
# returns its top five, however irrelevant.
RERANK_FLOOR=0.3

# --- Acceptance --------------------------------------------------------------
# The AC5 ceiling. 20 is the default argued in ACCEPTANCE.md and it is not a
# measured number: an answer is four sequential round trips, and how long those
# take depends entirely on which credential path you are on. Measure it on your
# own machine and put the number here. See ACCEPTANCE.md.
LATENCY_CEILING_SECONDS=20

# --- Which team is asking ----------------------------------------------------
# claims | underwriting | broker_support | complaints
# The default for the command-line scripts. The HTTP service takes it from the
# X-Northwind-Team header instead, which is where identity belongs.
TENANT_ID=claims

# --- The tool description, for the demonstration that breaks it --------------
# good | vague
TOOL_DESCRIPTION=good

# --- Postgres ----------------------------------------------------------------
# docker compose reads these too. POSTGRES_PASSWORD has no default on purpose:
# compose refuses to start without one rather than shipping a password in a
# file. Any value will do; this database is local and disposable.
POSTGRES_PASSWORD=
POSTGRES_DB=sagedesk
POSTGRES_USER=sagedesk
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Service -----------------------------------------------------------------
PORT=8080

# --- Deployment (GENAI_BACKEND=vertex only) ----------------------------------
# A GCS bucket Agent Runtime stages the packaged agent through, and the resource
# name deploy.py prints when it is finished.
STAGING_BUCKET=
AGENT_ENGINE_ID=
